{
  "name": "@bunny-command-center/shared",
  "private": true,
  "version": "0.1.0-scaffold",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "bcc-compiled-runtime": "./dist/index.js",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./i18n/*.json": "./src/i18n/*.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "i18n:lint": "tsx scripts/lint-i18n.ts",
    "i18n:lint:usage": "tsx scripts/lint-i18n-usage.ts",
    "i18n:lint:premiumplus": "tsx scripts/lint-i18n-premiumplus.ts"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
