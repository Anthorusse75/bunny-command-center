{
  "name": "@bunny-command-center/api",
  "private": true,
  "version": "0.1.0-scaffold",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "migrate": "tsx migrations/cli.ts",
    "codegen": "tsx scripts/codegen.ts",
    "codegen:check": "tsx scripts/check-codegen-freshness.ts",
    "e2e-db-setup": "tsx scripts/e2e-db-setup.ts",
    "e2e-server": "tsx scripts/e2e-server.ts"
  },
  "dependencies": {
    "@bunny-command-center/shared": "0.1.0-scaffold",
    "fastify": "5.11.3",
    "kysely": "0.29.5",
    "mysql2": "3.23.3",
    "pino": "10.3.1"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "kysely-codegen": "0.20.0",
    "pino-pretty": "13.1.3",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
