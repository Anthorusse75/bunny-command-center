# Placeholder values only. Never commit a real .env file (see ../../.gitignore).

# --- Dashboard runtime DB connection (apps/api Fastify + Kysely) ---
# Used to read/write Dashboard-owned tables and the small set of
# explicitly-authorized shared-table writes (see 25_DATA_MODEL.md). This
# account should NOT have DDL privileges in production - schema changes only
# ever happen through the migrator account below (00_GLOBAL_IMPLEMENTATION_RULES.md,
# "no runtime DDL outside the migrator").
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=bunny_dashboard_app
DB_PASSWORD=changeme
DB_NAME=bunny_command_center

# --- Dashboard migration runner DB connection (apps/api/migrations) ---
# A DISTINCT account from DB_* above, WITH DDL privileges
# (CREATE/ALTER/DROP/INDEX). Mirrors the convention already used by
# 01_NEW_SELF_BOTS/database/migrate.py (MIGRATOR_DB_*). Only ever read by
# migrations/cli.ts, never by the running server.
MIGRATOR_DB_HOST=127.0.0.1
MIGRATOR_DB_PORT=3306
MIGRATOR_DB_USER=bunny_dashboard_migrator
MIGRATOR_DB_PASSWORD=changeme
MIGRATOR_DB_NAME=bunny_command_center

# Controls what migrations/cli.ts is allowed to do. PRODUCTION (or unset) is
# fail-safe: `up` only. `down` requires TEST or LOCAL_DISPOSABLE, exactly
# like the self-bot migrator's RUNNER_ENV.
RUNNER_ENV=LOCAL_DISPOSABLE

# --- Fastify server ---
PORT=8080
LOG_LEVEL=info

# --- /api/version payload ---
DASHBOARD_APP_VERSION=0.1.0-scaffold

# --- Realtime infrastructure (03_realtime_infrastructure.md) ---
# 26_REALTIME_SSE_AND_SYNC.md: "`heartbeat` fires every 15s" - default matches.
SSE_HEARTBEAT_SECONDS=15
# 03_realtime_infrastructure.md: "An internal poller (2-5s interval)".
SSE_POLL_INTERVAL_MS=3000
# Backpressure bound (mission §16) - per-connection outbound queue depth
# before the oldest queued frame is dropped.
SSE_MAX_QUEUED_FRAMES=200
# Max rows fetched from one source adapter per poll tick (29_PERFORMANCE_AND_SCALABILITY.md).
SSE_MAX_ROWS_PER_SOURCE_PER_TICK=500

# --- Discord OAuth (04_discord_oauth_sessions.md, 07_DISCORD_OAUTH.md) ---
# The Bunny OCR DISCORD APPLICATION's Client ID/Secret (registered on the
# Discord Developer Portal) — NEVER BOT_OCR (the bot token). client_secret is
# server-only, never sent to the browser, never logged.
DISCORD_CLIENT_ID=changeme
DISCORD_CLIENT_SECRET=changeme
# Must exactly match a redirect URI registered on the Discord application for
# this environment (dev/staging/prod each register their own).
DISCORD_REDIRECT_URI=http://localhost:8080/api/auth/callback
# ADR-004 (corrected 2026-08-11, second pass) — do not narrow without reading
# that ADR and this step's HANDOVER first.
DISCORD_OAUTH_SCOPE=identify guilds guilds.members.read
# Overridable so a local/CI environment can point at a controlled test double
# instead of the real Discord hosts (never overridden in production).
DISCORD_AUTHORIZE_BASE_URL=https://discord.com/oauth2/authorize
DISCORD_TOKEN_URL=https://discord.com/api/oauth2/token
DISCORD_API_BASE_URL=https://discord.com/api

# --- Sessions (ADR-020) ---
DASHBOARD_SESSION_COOKIE_NAME=bcc_session
DASHBOARD_OAUTH_TRANSACTION_COOKIE_NAME=bcc_oauth_txn
# 32 raw bytes, hex or base64 encoded. Signs the short-lived pre-auth OAuth
# transaction cookie (tamper detection only, not encryption). Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DASHBOARD_OAUTH_TRANSACTION_SIGNING_KEY=changeme_64_hex_chars_______________________________________
# 32 raw bytes, hex or base64 encoded. Encrypts Discord access/refresh tokens
# at rest (AES-256-GCM, ADR-020) — from the deployment's secret store, NEVER
# the database itself. Generate the same way as the key above.
DASHBOARD_TOKEN_ENCRYPTION_KEY=changeme_64_hex_chars_______________________________________
DASHBOARD_SESSION_SLIDING_TTL_DAYS=30
DASHBOARD_SESSION_ABSOLUTE_TTL_DAYS=90
DASHBOARD_SESSION_SWEEP_INTERVAL_MINUTES=60

# --- RBAC: Superadmin (05_rbac_superadmin_idor.md, ADR-008) ---
# Exactly ONE, non-delegable Discord user ID -- never a DB row, never
# UI-editable (ADR-008). Must be a syntactically valid Discord snowflake
# (15-20 digits) -- server startup fails loudly if this is absent or
# malformed (apps/api/src/config.ts's requiredSnowflakeEnv). Set this to the
# REAL production Superadmin's Discord user ID in a real deployment's env --
# never commit a real value here (00_GLOBAL_IMPLEMENTATION_RULES.md #15).
PLATFORM_SUPERADMIN_DISCORD_ID=changeme_18_digit_discord_snowflake
