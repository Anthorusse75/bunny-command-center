# Placeholder values only. Never commit a real .env file (see ../../.gitignore).

# --- Dashboard runtime DB connection (apps/api Fastify + Kysely) ---
# Used to read/write Dashboard-owned tables and the small set of
# explicitly-authorized shared-table writes (see 25_DATA_MODEL.md). This
# account should NOT have DDL privileges in production - schema changes only
# ever happen through the migrator account below (00_GLOBAL_IMPLEMENTATION_RULES.md,
# "no runtime DDL outside the migrator").
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=bunny_dashboard_app
DB_PASSWORD=changeme
DB_NAME=bunny_command_center

# --- Dashboard migration runner DB connection (apps/api/migrations) ---
# A DISTINCT account from DB_* above, WITH DDL privileges
# (CREATE/ALTER/DROP/INDEX). Mirrors the convention already used by
# 01_NEW_SELF_BOTS/database/migrate.py (MIGRATOR_DB_*). Only ever read by
# migrations/cli.ts, never by the running server.
MIGRATOR_DB_HOST=127.0.0.1
MIGRATOR_DB_PORT=3306
MIGRATOR_DB_USER=bunny_dashboard_migrator
MIGRATOR_DB_PASSWORD=changeme
MIGRATOR_DB_NAME=bunny_command_center

# Controls what migrations/cli.ts is allowed to do. PRODUCTION (or unset) is
# fail-safe: `up` only. `down` requires TEST or LOCAL_DISPOSABLE, exactly
# like the self-bot migrator's RUNNER_ENV.
RUNNER_ENV=LOCAL_DISPOSABLE

# --- Fastify server ---
PORT=8080
LOG_LEVEL=info

# --- /api/version payload ---
DASHBOARD_APP_VERSION=0.1.0-scaffold
