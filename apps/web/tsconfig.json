{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "types": ["vite/client", "vitest/globals"]
  },
  // `scripts` holds the CI gates (contrast check) and `e2e` the Playwright suite. Both are
  // typechecked and linted like the rest of the app; neither is ever imported BY `src`, so the
  // one-way dependency direction that keeps `tsc` from emitting outside `outDir` is preserved.
  "include": ["src", "scripts", "e2e", "vite.config.ts", "playwright.config.ts"]
}
