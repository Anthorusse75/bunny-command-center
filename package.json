{
  "name": "bunny-command-center",
  "private": true,
  "version": "0.1.0-scaffold",
  "type": "module",
  "engines": {
    "node": "^24.19.0",
    "npm": "^11.17.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "vite": "7.3.6"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces --if-present",
    "i18n:lint": "npm run i18n:lint --workspace=packages/shared && npm run i18n:lint:usage --workspace=packages/shared",
    "contrast:check": "npm run contrast:check --workspace=apps/web",
    "test:e2e": "npm run test:e2e --workspace=apps/web",
    "migrate": "npm run migrate --workspace=apps/api",
    "codegen": "npm run codegen --workspace=apps/api"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-i18next": "6.1.5",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10"
  }
}
